# LLM
# aisa | openai
LLM_PROVIDER=aisa
AISA_API_KEY=
AISA_BASE_URL=https://api.aisa.one/v1
# exact ID from AIsa's model list (may be prefixed, e.g. "openai/...")
AISA_MODEL=gpt-6.1-terra
# fallback, or primary when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# reasoning_effort for tutor replies
LLM_TUTOR_EFFORT=low
# reasoning_effort for leak check / grading
LLM_CHECK_EFFORT=none

# Database
POSTGRES_USER=socra
POSTGRES_PASSWORD=socra
POSTGRES_DB=socra
# host dev; Compose overrides
DATABASE_URL=postgresql://socra:socra@localhost:5432/socra
# host port for the Compose db (change if a local Postgres uses 5432)
DB_PORT=5432

# App (Rust server)
# 32+ random chars
SESSION_SECRET=
PORT=3000
# built React app; Compose sets /app/static
STATIC_DIR=../frontend/dist
# true behind HTTPS
SECURE_COOKIES=false
DAILY_TOKEN_CAP=1000
# true during the demo: fixed problem numbers for the demo accounts only
DEMO_FIXED_SEEDS=false

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
# JSON array secret key (fee payer + mint authority); `cargo run --bin setup_token -- --keygen`
MINT_AUTHORITY_SECRET=
# written by `cargo run --bin setup_token`
MINT_ADDRESS=
TOKEN_DECIMALS=2

# P2 (optional; features hide if empty)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
KEENABLE_API_KEY=
KEENABLE_BASE_URL=https://api.keenable.ai
